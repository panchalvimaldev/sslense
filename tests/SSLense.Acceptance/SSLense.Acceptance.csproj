<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SSLense.Core\SSLense.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- scriptcheck runs the Cloudflare example that ships with SSLense. -->
    <None Include="..\..\dns-scripts\*.ps1" Link="dns-scripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
