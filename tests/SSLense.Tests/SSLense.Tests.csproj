<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SSLense.Core\SSLense.Core.csproj" />
    <!-- The app's view models, built as at startup by GuiStartupTests. -->
    <ProjectReference Include="..\..\src\SSLense.Gui\SSLense.Gui.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The example DNS scripts that ship with SSLense, run by DnsScriptTests. -->
    <None Include="..\..\dns-scripts\*.ps1" Link="dns-scripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The example deployment scripts, run by DeploymentServiceTests. -->
    <None Include="..\..\deploy-scripts\*.ps1" Link="deploy-scripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
