<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Single product version for every app and the MSI. Increase it for each release so MSI upgrades apply. -->
    <Version>0.9.0</Version>

    <!--
      Publisher shown in file properties, Add/Remove Programs, and the MSI. Placeholder until the
      registered name is decided; it must then match the name on the code-signing certificate.
    -->
    <Company>ProAcSys</Company>
    <Product>SSLense</Product>
    <Copyright>Copyright © 2026 The SSLense Authors. Licensed under the Apache License 2.0.</Copyright>
    <SSLenseRepoRoot>$(MSBuildThisFileDirectory)</SSLenseRepoRoot>
    <SSLenseIcon>$(SSLenseRepoRoot)assets\branding\sslense.ico</SSLenseIcon>
  </PropertyGroup>
</Project>
