<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!--
    UpgradeCode identifies the SSLense product family across every version. Never change it,
    or upgrades will install side by side instead of replacing the previous version.
  -->
  <Package
    Name="SSLense"
    Manufacturer="$(Manufacturer)"
    Version="$(ProductVersion)"
    UpgradeCode="46AACC03-4D31-4B13-B631-65B9718C4476"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of SSLense is already installed. Certificate data in C:\ProgramData\SSLense is never removed by the installer." />
    <MediaTemplate EmbedCab="yes" />

    <!-- msiexec /i SSLense.msi START_SERVICE=0 installs the renewal service without starting it. -->
    <Property Id="START_SERVICE" Value="1" Secure="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Shown in Add/Remove Programs and on the Start menu shortcut. -->
    <Icon Id="sslense.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="sslense.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SSLense">
        <Directory Id="GuiFolder" Name="gui" />
        <Directory Id="CliFolder" Name="cli" />
        <Directory Id="ServiceFolder" Name="service" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="SSLense">
      <ComponentGroupRef Id="GuiFiles" />
      <ComponentGroupRef Id="CliFiles" />
      <ComponentGroupRef Id="ServiceFiles" />
      <ComponentRef Id="ServiceStart" />
      <ComponentRef Id="CliOnPath" />
    </Feature>

    <!--
      Restrict C:\ProgramData\SSLense before the service starts. Runs as SYSTEM. Return="ignore" because
      the service and every elevated app start apply the same permissions again, so a failure here must
      not roll back the install.
    -->
    <CustomAction
      Id="SecureDataDirectory"
      FileRef="CliExe"
      ExeCommand="secure-data"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="SecureDataDirectory" Before="StartServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="GuiFiles" Directory="GuiFolder">
      <Files Include="$(PublishDir)gui\**">
        <Exclude Files="$(PublishDir)gui\SSLense.Gui.exe" />
      </Files>
      <!-- The Start menu shortcut lives on the executable's component so its per-machine KeyPath is the file. -->
      <Component Id="GuiExecutable">
        <File Id="GuiExe" Source="$(PublishDir)gui\SSLense.Gui.exe" KeyPath="yes">
          <Shortcut
            Id="GuiShortcut"
            Directory="ProgramMenuFolder"
            Name="SSLense"
            Description="Manage Let's Encrypt certificates for IIS"
            WorkingDirectory="GuiFolder"
            Icon="sslense.ico"
            Advertise="yes" />
        </File>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="CliFiles" Directory="CliFolder">
      <Files Include="$(PublishDir)cli\**">
        <Exclude Files="$(PublishDir)cli\SSLense.Cli.exe" />
      </Files>
      <Component Id="CliExecutable">
        <File Id="CliExe" Source="$(PublishDir)cli\SSLense.Cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ServiceFiles" Directory="ServiceFolder">
      <Files Include="$(PublishDir)service\**">
        <Exclude Files="$(PublishDir)service\SSLense.Service.exe" />
      </Files>
      <Component Id="ServiceExecutable">
        <File Id="ServiceExe" Source="$(PublishDir)service\SSLense.Service.exe" KeyPath="yes" />
        <ServiceInstall
          Id="SSLenseService"
          Name="SSLense"
          DisplayName="SSLense Renewal Service"
          Description="Renews SSLense-managed IIS certificates using Let's Encrypt."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem"
          Vital="yes">
          <!-- Restart one minute after each of the first three unexpected exits; the count resets daily. -->
          <util:ServiceConfig
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="60"
            ResetPeriodInDays="1" />
        </ServiceInstall>
        <!-- Stopped for upgrades and uninstall; removed only on uninstall. -->
        <ServiceControl Id="StopAndRemoveService" Name="SSLense" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="ServiceStart" Directory="ServiceFolder" Condition="START_SERVICE = &quot;1&quot;">
      <!-- Wait="no": a service that fails to start is reported by Windows and must not roll back the install. -->
      <ServiceControl Id="StartService" Name="SSLense" Start="install" Wait="no" />
      <RegistryValue Root="HKLM" Key="Software\SSLense" Name="StartServiceOnInstall" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Lets administrators run "SSLense.Cli status" from any elevated terminal. -->
    <Component Id="CliOnPath" Directory="CliFolder">
      <Environment Id="CliPath" Name="PATH" Value="[CliFolder]" Part="last" System="yes" Action="set" Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\SSLense" Name="CliOnPath" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
