<Window x:Class="SSLense.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SSLense.Gui.ViewModels"
        xmlns:views="clr-namespace:SSLense.Gui.Views"
        Title="SSLense" Height="800" Width="1280"
        Icon="Assets/sslense.ico"
        MinHeight="640" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddCertificateViewModel}">
            <views:AddCertificateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <views:ActivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <views:SettingsView Margin="28,24,28,28" />
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: name, the tabs, the health status, and the two actions that apply to everything. -->
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Image Source="Assets/sslense-icon.png" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="SSLense logo" />
                    <TextBlock Text="SSLense" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="10,0,12,0" VerticalAlignment="Center" />
                    <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="#FCD9A8" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                            ToolTip="New certificates come from Let's Encrypt staging, which browsers do not trust, unless you choose another certificate authority. Production needs your confirmation.">
                        <TextBlock Text="Staging by default" Foreground="#7A3B00" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The quick local health check (data folder, configuration, service, heartbeat, notifications). -->
                    <Button Command="{Binding OpenHealthCommand}" Style="{StaticResource LinkButton}" Margin="0,0,12,0"
                            ToolTip="Result of the quick health check. Click for the full check in Activity.">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Certificates.HealthState}" Value="Ok"><Setter Property="Fill" Value="#22C55E" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Certificates.HealthState}" Value="Warning"><Setter Property="Fill" Value="#F59E0B" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Certificates.HealthState}" Value="Fail"><Setter Property="Fill" Value="#DC2626" /></DataTrigger>
                                    </Style.Triggers></Style></Ellipse.Style>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Checking health…" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Certificates.HealthState}" Value="Ok"><Setter Property="Text" Value="Health check passed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Certificates.HealthState}" Value="Warning"><Setter Property="Text" Value="{Binding Certificates.HealthAlertTitle}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Certificates.HealthState}" Value="Fail"><Setter Property="Text" Value="{Binding Certificates.HealthAlertTitle}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Certificates.HealthState}" Value="Unknown"><Setter Property="Text" Value="Health unknown" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Content="Renew all due" Command="{Binding RenewAllCommand}" Margin="0,0,8,0"
                            ToolTip="Renew every automatic certificate that is due. Certificates you bought are installed by you, from the certificate's own screen." />
                    <Button Content="＋  Add certificate" Command="{Binding AddCertificateCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Style="{StaticResource WindowTabs}"
                         AutomationProperties.Name="Main tabs">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Only while an operation started here runs, or after one fails. -->
        <Border Grid.Row="1" Background="{StaticResource BrandSoftBrush}" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="20,8"
                Visibility="{Binding Certificates.ShowActivity, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.Name="Running operation">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding Certificates.CancelCommand}" Style="{StaticResource LinkButton}" />
                <Button DockPanel.Dock="Right" Content="Show progress" Command="{Binding OpenActivityCommand}" Style="{StaticResource LinkButton}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Certificates.Activity}" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding Certificates.ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</Window>
