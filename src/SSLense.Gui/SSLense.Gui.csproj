<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>$(SSLenseIcon)</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SSLense.Core\SSLense.Core.csproj" />
    <Compile Include="..\Shared\LogFileConfiguration.cs" Link="LogFileConfiguration.cs" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Branding lives in assets\branding at the repository root; it is linked, not copied. -->
    <Resource Include="$(SSLenseIcon)" Link="Assets\sslense.ico" />
    <Resource Include="..\..\assets\branding\sslense-icon-512.png" Link="Assets\sslense-icon.png" />
  </ItemGroup>
</Project>
