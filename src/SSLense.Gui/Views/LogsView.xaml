<UserControl x:Class="SSLense.Gui.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Activity › Log: what SSLense, its service, and the CLI did. -->
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
                <CheckBox DockPanel.Dock="Right" Content="Live" IsChecked="{Binding IsLive}" VerticalAlignment="Center"
                          ToolTip="Update every two seconds. Updates also pause while text is selected." />
                <StackPanel>
                    <TextBlock Text="Log" Style="{StaticResource SectionTitle}" FontSize="15" />
                    <TextBlock Text="What SSLense, its service, and the command line did. Select text to copy it." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="170" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             AutomationProperties.Name="Search" ToolTip="Show only entries containing this text, such as a site or host name." />
                    <TextBlock Text="Search, such as a domain or site" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"
                          AutomationProperties.Name="Level" ToolTip="Which entries to show. Error also shows each error's details." />
                <ComboBox Grid.Column="4" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" DisplayMemberPath="Label"
                          AutomationProperties.Name="Log file" ToolTip="Today's log, or an earlier day's." />
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="{Binding Summary}" Style="{StaticResource WhenSet}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource WhenSet}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource WhenSet}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="3" CornerRadius="6" ClipToBounds="True" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <!-- A read-only text box rather than a list, so any part of the log can be selected and copied. -->
                    <TextBox x:Name="LogText" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="12" MinHeight="0"
                             VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             SelectionChanged="OnLogSelectionChanged" TextChanged="OnLogTextChanged"
                             ScrollViewer.ScrollChanged="OnLogScrollChanged" AutomationProperties.Name="Log entries" />
                    <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Copy all" Command="{Binding CopyAllCommand}" Style="{StaticResource LinkButton}"
                        ToolTip="Copy every entry shown. To copy part of the log, select it and press Ctrl+C." />
                <Button Content="Save a copy to the Desktop" Command="{Binding SaveCopyCommand}" Style="{StaticResource LinkButton}"
                        ToolTip="The log folder is restricted to Administrators, so SSLense saves a copy you can open or attach." />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource LinkButton}" />
                <Button Content="Clear today's log…" Click="OnClearLogClick" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}"
                        IsEnabled="{Binding IsTodaySelected}"
                        ToolTip="Empty today's log so it shows only what happens next. The earlier entries are kept as a backup." />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
