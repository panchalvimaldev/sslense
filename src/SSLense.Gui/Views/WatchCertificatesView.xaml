<UserControl x:Class="SSLense.Gui.Views.WatchCertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add certificate › It's already installed in IIS: tick the bindings to watch. -->
    <Border Style="{StaticResource Card}" Padding="0" MaxWidth="1000" HorizontalAlignment="Left" VerticalAlignment="Top">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="20,16">
                <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Command="{Binding RefreshCommand}" Style="{StaticResource LinkButton}"
                        ToolTip="Read the bindings again" AutomationProperties.Name="Read the bindings again" />
                <TextBlock Text="Tick the HTTPS bindings to watch. SSLense adds reminders and checks; nothing in IIS changes." Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="20,14">
                <Button Content="{Binding AdoptCheckedLabel}" Command="{Binding AdoptCheckedCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
            </DockPanel>
            <DataGrid ItemsSource="{Binding Bindings}" SelectionMode="Single" MaxHeight="440" AutomationProperties.Name="HTTPS bindings"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="52">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdopt}"
                                          HorizontalAlignment="Center" AutomationProperties.Name="{Binding Address, StringFormat=Watch {0}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Domain" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Address}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="IIS site" Binding="{Binding SiteName}" Width="*" />
                    <DataGridTextColumn Header="Issued by" Binding="{Binding Issuer}" Width="1.6*" />
                    <DataGridTextColumn Header="Expires" Binding="{Binding Expires, StringFormat={}{0:dd MMM yyyy}}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
