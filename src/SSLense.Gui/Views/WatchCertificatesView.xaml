<UserControl x:Class="SSLense.Gui.Views.WatchCertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add certificate › It's already installed in IIS: tick the bindings to watch. -->
    <StackPanel HorizontalAlignment="Left" MaxWidth="1000">
    <Border Style="{StaticResource Card}" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="20,16">
                <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Command="{Binding RefreshCommand}" Style="{StaticResource LinkButton}"
                        ToolTip="Read the bindings again" AutomationProperties.Name="Read the bindings again" />
                <TextBlock Text="Tick the HTTPS bindings to watch. SSLense adds reminders and checks; nothing in IIS changes." Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="20,14">
<StackPanel Orientation="Horizontal">
                                <Button Content="{Binding AdoptCheckedLabel}" Command="{Binding AdoptCheckedCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                <Button Content="Tick all" Command="{Binding TickAllCommand}" Style="{StaticResource LinkButton}" Margin="14,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Tick every binding that can be watched" />
                </StackPanel>
            </DockPanel>
            <DataGrid ItemsSource="{Binding Bindings}" SelectionMode="Single" MaxHeight="440" AutomationProperties.Name="HTTPS bindings"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="52">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdopt}"
                                          HorizontalAlignment="Center" AutomationProperties.Name="{Binding Address, StringFormat=Watch {0}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Domain" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Address}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="IIS site" Binding="{Binding SiteName}" Width="*" />
                    <DataGridTextColumn Header="Issued by" Binding="{Binding Issuer}" Width="1.6*" />
                    <DataGridTextColumn Header="Expires" Binding="{Binding Expires, StringFormat={}{0:dd MMM yyyy}}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
    <!-- A certificate on another machine: read over TLS, never changed (docs/design/remote-certificates.md). -->
    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
            <TextBlock Text="On another machine" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="A load balancer, firewall or appliance that serves HTTPS itself. SSLense reads its certificate every day, reminds you before it expires, and notices when it is replaced. It never changes anything there." />
            <WrapPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Name" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding RemoteName, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" AutomationProperties.Name="Name for the certificate on another machine" /></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Host name or address" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" MinWidth="240" AutomationProperties.Name="Host name or address of the other machine" /></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Port" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.Name="Port" /></StackPanel>
            </WrapPanel>
            <Button Content="Watch" Command="{Binding WatchRemoteCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
    </Border>
    </StackPanel>
</UserControl>
