<UserControl x:Class="SSLense.Gui.Views.AddCertificateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SSLense.Gui.Views">
    <UserControl.Resources>
        <!-- An answer to "Where does the certificate come from?". -->
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,14,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="#F8FAFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" VerticalAlignment="Top" />
            <StackPanel>
                <Button Content="← Choose a different source" Command="{Binding BackCommand}" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Padding="0,2" MinHeight="0" Margin="0,0,0,6"
                        Visibility="{Binding IsChoosing, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <TextBlock Text="Add certificate" Style="{StaticResource DetailTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- The outcome of the three screens for certificates bought elsewhere, above them so it is always in view. -->
        <StackPanel Grid.Row="1" DataContext="{Binding OtherProviders}"
                    Visibility="{Binding DataContext.IsFromProvider, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Margin="0,0,0,12">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
                    <Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <Border Margin="0,0,0,12">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SuccessBanner}">
                    <Style.Triggers><DataTrigger Binding="{Binding ResultMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="Working…" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- Where does the certificate come from? -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Sources}" Focusable="False" MaxWidth="980" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Visibility="{Binding IsChoosing, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.Name="Where the certificate comes from">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding Choose}" Style="{StaticResource ChoiceCard}" AutomationProperties.Name="{Binding Title}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Recommended, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Recommended" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <views:IssueCertificateView Grid.Row="2" DataContext="{Binding Issue}"
                                    Visibility="{Binding DataContext.IsAutomatic, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <views:ImportPfxView Grid.Row="2" DataContext="{Binding OtherProviders}"
                             Visibility="{Binding DataContext.IsFile, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <views:CertificateRequestView Grid.Row="2" DataContext="{Binding OtherProviders}"
                                      Visibility="{Binding DataContext.IsRequest, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <views:WatchCertificatesView Grid.Row="2" DataContext="{Binding OtherProviders}"
                                     Visibility="{Binding DataContext.IsWatch, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
