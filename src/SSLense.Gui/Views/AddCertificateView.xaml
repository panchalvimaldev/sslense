<UserControl x:Class="SSLense.Gui.Views.AddCertificateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SSLense.Gui.Views">
    <!-- Step 1 of docs/design/gui-redesign.md: the current screens as tabs, until step 2 asks where the certificate comes from. -->
    <TabControl Style="{StaticResource SectionTabs}" SelectedIndex="{Binding SelectedTab}" Margin="28,14,28,24"
                AutomationProperties.Name="Where the certificate comes from">
        <TabItem Header="Free and automatic (Let's Encrypt)">
            <views:IssueCertificateView DataContext="{Binding Issue}" />
        </TabItem>
        <TabItem Header="Bought from a provider, or already in IIS">
            <views:OtherProvidersView DataContext="{Binding OtherProviders}" />
        </TabItem>
    </TabControl>
</UserControl>
