<UserControl x:Class="SSLense.Gui.Views.CertificateRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add certificate › the provider needs a request: create one, then install what the provider sends. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <!-- Requests waiting for the provider come first: finishing one is the usual reason to be here. -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16"
                    Visibility="{Binding HasPendingRequests, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Waiting for your provider" Style="{StaticResource SectionTitle}" FontSize="15" />
                    <TextBlock Text="Choose a request to copy it again, or to install the certificate the provider sent for it." Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <ListBox ItemsSource="{Binding PendingRequests}" SelectedItem="{Binding SelectedPending}" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Requests waiting for the provider">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="#BFDBFE" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Hosts}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                        <Run Text="IIS site" /> <Run Text="{Binding IisSite, Mode=OneWay}" /><Run Text=" · created" /> <Run Text="{Binding Created, StringFormat={}{0:dd MMM yyyy}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding KeyType, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Visibility="{Binding HasSelectedPending, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Copy" Click="OnCopyCsrClick" Margin="0,0,8,0" />
                                <Button Content="Save as…" Click="OnSaveCsrClick" />
                            </StackPanel>
                            <TextBlock Text="The request (CSR) to give your provider" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom" />
                        </DockPanel>
                        <TextBox Text="{Binding SelectedCsr, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" Height="96"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Certificate request" />

                        <TextBlock Text="Certificate from the provider (.crt, .cer or .pem)" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseCertificateClick" Margin="8,0,0,0" />
                            <TextBox Text="{Binding CertificatePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Certificate file" />
                        </DockPanel>
                        <TextBlock Text="Intermediate bundle (optional; often named ca-bundle)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseChainClick" Margin="8,0,0,0" />
                            <TextBox Text="{Binding ChainPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Intermediate bundle file" />
                        </DockPanel>
                        <Expander Header="Advanced" Margin="0,12,0,0" Foreground="{StaticResource BrandBrush}">
                            <CheckBox Content="Replace a certificate that SSLense renews automatically" IsChecked="{Binding CompleteForce}" Margin="0,10,0,0" Foreground="{StaticResource TextBrush}" />
                        </Expander>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Install certificate" Command="{Binding CompleteCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                            <Button Content="Cancel request…" Click="OnCancelRequestClick" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="New request" Style="{StaticResource SectionTitle}" FontSize="15" />
                    <TextBlock Text="SSLense creates the private key on this server, where it stays, and a request (CSR) to paste into your provider's order or renewal form." Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="IIS site" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding RequestSite}" DisplayMemberPath="Name" AutomationProperties.Name="Site for the request" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Key type" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding KeyTypes}" SelectedItem="{Binding SelectedKeyType}" DisplayMemberPath="Label" AutomationProperties.Name="Key type" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Domains" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding RequestHosts, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Domains for the request" />
                    <TextBlock Text="Separate several with commas. The first becomes the certificate's main name. On a site with several certificates, keep only this certificate's domains." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button Content="Create request" Command="{Binding CreateRequestCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
