<UserControl x:Class="SSLense.Gui.Views.IssueCertificateView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility" /></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="Issue a certificate" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="Configure, validate, and install a certificate from Let's Encrypt or another ACME certificate authority." Style="{StaticResource PageSubtitle}"/>
  </StackPanel>

  <Grid Grid.Row="1" Margin="16,0,16,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Border x:Name="StepOneCircle" Width="30" Height="30" CornerRadius="15" Background="{StaticResource BrandBrush}"><TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Select site" FontWeight="SemiBold"/><TextBlock Text="IIS binding" Style="{StaticResource CaptionText}"/></StackPanel></StackPanel>
   <Border Grid.Column="1" Height="1" Background="{StaticResource BorderBrush}" Margin="16,0" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="15"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E2E8F0"/><Style.Triggers><DataTrigger Binding="{Binding IsStepTwo}" Value="True"><Setter Property="Background" Value="{StaticResource BrandBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsStepThree}" Value="True"><Setter Property="Background" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="2"/><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsStepTwo}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger><DataTrigger Binding="{Binding IsStepThree}" Value="True"><Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Pre-flight" FontWeight="SemiBold"/><TextBlock Text="Verify readiness" Style="{StaticResource CaptionText}"/></StackPanel></StackPanel>
   <Border Grid.Column="3" Height="1" Background="{StaticResource BorderBrush}" Margin="16,0" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="4" Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="15"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E2E8F0"/><Style.Triggers><DataTrigger Binding="{Binding IsStepThree}" Value="True"><Setter Property="Background" Value="{StaticResource BrandBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="3" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsStepThree}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Issue" FontWeight="SemiBold"/><TextBlock Text="Install certificate" Style="{StaticResource CaptionText}"/></StackPanel></StackPanel>
  </Grid>

  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
   <Grid>
    <StackPanel Visibility="{Binding IsStepOne, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Text="Choose an IIS site" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="Select the website and host names SSLense should secure." Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>
     <CheckBox Content="No IIS site: for Remote Desktop, SQL Server, Exchange, or another service" IsChecked="{Binding NoSite}" Margin="0,0,0,10" AutomationProperties.Name="Certificate with no IIS site" ToolTip="Nothing is bound in IIS. After issuing, add deployment steps in Certificate Details to hand the certificate to its service. Needs DNS validation."/>
     <StackPanel Visibility="{Binding NoSite, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
      <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding NoSiteName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Certificate name"/>
      <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="How SSLense lists this certificate, such as Remote Desktop. It must not be the name of an IIS site. Enter the names it covers under Certificate names, and choose a DNS validation method."/>
     </StackPanel>
     <StackPanel Visibility="{Binding ShowSitePicker, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Text="IIS SITE" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}" DisplayMemberPath="DisplayName" Margin="0,0,0,10" AutomationProperties.Name="IIS site"/>
     <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10" Visibility="{Binding SelectedSite.HasHttps, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
      <StackPanel>
       <TextBlock Text="This site already serves HTTPS" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding SelectedSite.HttpsSummary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
       <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                  Text="Issuing replaces that certificate for the host names you select, for example to move from a certificate you renew by hand to one SSLense renews automatically. To keep it and only get expiry reminders, adopt it on the Other Providers page instead."/>
       <CheckBox Content="Replace the current certificate even if it is still valid" IsChecked="{Binding ReplaceExisting}" Margin="0,8,0,0" AutomationProperties.Name="Replace the current certificate even if it is still valid"/>
      </StackPanel>
     </Border>
     </StackPanel>
     <CheckBox Content="Exportable private key, to export it to PFX or PEM files or the IIS Central Certificate Store" IsChecked="{Binding ExportableKey}" Margin="0,4,0,0" AutomationProperties.Name="Exportable private key" ToolTip="Off by default: a key that cannot be exported cannot be copied off this server. Turn it on only to add export steps in Certificate Details. Kept at every renewal."/>
     <TextBlock Text="VALIDATION" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
     <WrapPanel>
      <RadioButton GroupName="Validation" Content="HTTP (port 80)" IsChecked="{Binding UseHttpValidation}" Margin="0,0,20,0" AutomationProperties.Name="HTTP validation"/>
      <RadioButton GroupName="Validation" Content="DNS provider (wildcards, automatic renewal)" IsChecked="{Binding UseDnsProvider}" Margin="0,0,20,0" AutomationProperties.Name="DNS provider validation"/>
      <RadioButton GroupName="Validation" Content="DNS manual (any DNS service)" IsChecked="{Binding UseDnsManual}" AutomationProperties.Name="Manual DNS validation"/>
     </WrapPanel>
     <TextBlock Text="{Binding ValidationHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <Border Style="{StaticResource InfoBanner}" Margin="0,10,0,0" Visibility="{Binding UseDnsManual, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
       <TextBlock Text="This certificate cannot renew automatically" FontWeight="SemiBold"/>
       <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="Each renewal needs new DNS records, so you must renew it by hand before it expires. SSLense reminds you in the daily digest. To avoid this with a DNS service SSLense does not support, add a permanent CNAME that points _acme-challenge to a zone on a supported provider, then use the DNS provider option."/>
      </StackPanel>
     </Border>
     <StackPanel Margin="0,10,0,0" Visibility="{Binding UsesDns, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="CERTIFICATE NAMES (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding CertificateNames, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Certificate names"/>
      <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="For a wildcard, enter for example *.example.com, example.com. A wildcard covers one level and does not include example.com itself. Leave this empty to cover only the host names below."/>
     </StackPanel>
     <StackPanel Visibility="{Binding ShowSitePicker, Converter={StaticResource BoolToVisibility}}">
     <Border Height="10"/>
     <TextBlock Text="HOST NAMES" Style="{StaticResource FieldLabel}"/>
     <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,7">
     <ItemsControl ItemsSource="{Binding Hosts}"><ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
       <CheckBox Content="{Binding Host}" IsChecked="{Binding IsSelected}" FontWeight="SemiBold" AutomationProperties.Name="{Binding Host}"/>
       <TextBlock Grid.Column="1" Text="{Binding BindingStatus}" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsReady}" Value="False"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
     </StackPanel>
    </StackPanel>

    <StackPanel Visibility="{Binding IsStepTwo, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Text="Verify issuance readiness" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="{Binding PreflightSubtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>
     <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,14" Visibility="{Binding IsRenewingByHand, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding RenewalNotice}" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
     <TextBlock Text="ACME ACCOUNT EMAIL" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" AutomationProperties.Name="ACME account email"/>
     <TextBlock Text="CERTIFICATE AUTHORITY" Style="{StaticResource FieldLabel}"/>
     <ComboBox ItemsSource="{Binding Authorities}" SelectedItem="{Binding SelectedAuthority}" Margin="0,0,0,4" MaxWidth="460" HorizontalAlignment="Left" MinWidth="320"
               AutomationProperties.Name="Certificate authority" IsEnabled="{Binding CanChooseAuthority}">
      <ComboBox.ItemTemplate>
       <DataTemplate>
        <TextBlock>
         <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ("/><Run Text="{Binding Id, Mode=OneWay}"/><Run Text=")"/>
        </TextBlock>
       </DataTemplate>
      </ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock Text="Let's Encrypt staging is the safe default: its certificates are not trusted, so mistakes cost nothing. Add other certificate authorities under Settings → Certificate authorities." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Border Margin="0,0,0,16"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UseProduction}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="Certificates from this certificate authority are publicly trusted, and its limits apply." Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/><CheckBox Content="I confirm the site and host names are correct and authorize replacing the live IIS binding." IsChecked="{Binding ProductionRiskAccepted}" Margin="0,8,0,0" AutomationProperties.Name="Confirm site and host names and authorize replacing the live IIS binding"/></StackPanel></Border>
     <Button Content="Run pre-flight checks" Command="{Binding PreflightCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
     <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
     <DataGrid ItemsSource="{Binding PreflightChecks}" Height="210" AutomationProperties.Name="Pre-flight results">
      <DataGrid.Columns><DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70"/><DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="2*"/></DataGrid.Columns>
     </DataGrid></Border>
     <TextBlock Text="{Binding ResultMessage}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,12,0,0"/>
    </StackPanel>

    <StackPanel Visibility="{Binding IsStepThree, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Text="Issuing certificate" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="Keep this window open while SSLense validates and installs the certificate." Style="{StaticResource PageSubtitle}" Margin="0,4,0,16"/>
     <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,14" Visibility="{Binding IsWaitingForManualDns, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
       <TextBlock Text="Create these TXT records in your DNS service" FontWeight="SemiBold"/>
       <TextBlock TextWrapping="Wrap" Margin="0,3,0,10" Text="Keep every record, even when two have the same name: each value is needed. Set the lowest TTL your DNS service allows. SSLense then checks that the records are visible, for up to 5 minutes."/>
       <ItemsControl ItemsSource="{Binding ManualRecords}" AutomationProperties.Name="DNS records to create">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <StackPanel Margin="0,0,0,10">
           <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
           <TextBox Text="{Binding Name, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="Record name"/>
           <TextBlock Text="VALUE" Style="{StaticResource FieldLabel}" Margin="0,6,0,6"/>
           <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="Record value"/>
          </StackPanel>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <Button Content="I have created the records" Command="{Binding ConfirmManualRecordsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
      </StackPanel>
     </Border>
     <Border CornerRadius="7" ClipToBounds="True"><ListBox ItemsSource="{Binding ProgressLines}" Height="310" Style="{StaticResource ConsoleList}"/></Border>
     <Border Style="{StaticResource SuccessBanner}" Margin="0,14,0,0"><TextBlock Text="{Binding ResultMessage}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/></Border>
    </StackPanel>
   </Grid>
   </ScrollViewer>
  </Border>
  <DockPanel Grid.Row="3" Margin="0,14,0,0">
   <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsStepOne}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button Content="Continue" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsStepOne, Converter={StaticResource BoolToVisibility}}"/>
    <Button Content="Issue certificate" Command="{Binding IssueCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsStepTwo, Converter={StaticResource BoolToVisibility}}"/>
    <Button Content="Cancel operation" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <Button Content="Start over" Command="{Binding StartOverCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsStepThree, Converter={StaticResource BoolToVisibility}}"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</UserControl>
