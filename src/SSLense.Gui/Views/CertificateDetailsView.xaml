<UserControl x:Class="SSLense.Gui.Views.CertificateDetailsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <StackPanel><TextBlock Text="Certificate details" Style="{StaticResource PageTitle}"/><TextBlock Text="Review installation, bindings, and recent certificate activity." Style="{StaticResource PageSubtitle}"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
    <Button Content="Remove" Click="OnRemoveClick" Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
    <Button Content="Order replacement" Command="{Binding OrderReplacementCommand}" Margin="0,0,8,0" ToolTip="Certificates from other providers are renewed by ordering again from the provider: create a request, then complete it."/>
    <Button Content="Renew now" Command="{Binding RenewCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Replace the certificate now from the certificate authority that issued it (Let's Encrypt)."/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
   <DockPanel><TextBlock DockPanel.Dock="Left" Text="MANAGED IIS SITE" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}" Width="320" HorizontalAlignment="Left"/><StackPanel Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></DockPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,14,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Grid.ColumnSpan="2" Text="Certificate information" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
     <TextBlock Grid.Row="1" Text="Host names" Style="{StaticResource CaptionText}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hosts}" TextWrapping="Wrap" FontWeight="SemiBold"/>
     <TextBlock Grid.Row="2" Text="Source" Style="{StaticResource CaptionText}" Margin="0,14,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Environment}" TextWrapping="Wrap" Margin="0,14,0,0" FontWeight="SemiBold"/>
     <TextBlock Grid.Row="3" Text="Issuer" Style="{StaticResource CaptionText}" Margin="0,14,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Issuer}" TextWrapping="Wrap" Margin="0,14,0,0"/>
     <TextBlock Grid.Row="4" Text="Thumbprint" Style="{StaticResource CaptionText}" Margin="0,14,0,0"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Thumbprint}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" Margin="0,11,0,0" FontFamily="Consolas"/>
     <TextBlock Grid.Row="5" Text="Issued" Style="{StaticResource CaptionText}" Margin="0,14,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding IssueDate}" Margin="0,14,0,0"/>
     <TextBlock Grid.Row="6" Text="Expires" Style="{StaticResource CaptionText}" Margin="0,14,0,0"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ExpiryDate}" Margin="0,14,0,0" FontWeight="SemiBold"/>
     <TextBlock Grid.Row="7" Text="Bound sites" Style="{StaticResource CaptionText}" Margin="0,14,0,0"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding BoundSites}" Margin="0,14,0,0"/>
    </Grid>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}" Margin="18,15"/><ListBox Grid.Row="1" ItemsSource="{Binding RecentLogLines}" Style="{StaticResource ConsoleList}"/></Grid></Border>
  </Grid>
 </Grid>
</UserControl>
