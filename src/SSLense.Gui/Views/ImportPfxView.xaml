<UserControl x:Class="SSLense.Gui.Views.ImportPfxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add certificate › I bought it and have the file. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Padding="24" MaxWidth="900" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="IIS site" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding ImportSite}" DisplayMemberPath="Name" AutomationProperties.Name="IIS site" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Domains to bind (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ImportHosts, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Domains to bind"
                                 ToolTip="Leave empty to bind every host name of the site that the certificate covers. Separate several with commas." />
                    </StackPanel>
                </Grid>

                <TextBlock Text="PFX file" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowsePfxClick" Margin="8,0,0,0" />
                    <TextBox Text="{Binding PfxPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PFX file" />
                </DockPanel>
                <TextBlock Text="The file from your provider, with its private key and intermediate certificates (.pfx or .p12)." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                <PasswordBox x:Name="PfxPasswordBox" PasswordChanged="OnPfxPasswordChanged" MaxWidth="420" HorizontalAlignment="Left" Width="420" AutomationProperties.Name="PFX password" />

                <Expander Header="Advanced" Margin="0,16,0,0" Foreground="{StaticResource BrandBrush}">
                    <CheckBox Content="Replace a certificate that SSLense renews automatically" IsChecked="{Binding ImportForce}" Margin="0,10,0,0" Foreground="{StaticResource TextBrush}" />
                </Expander>

                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0"
                           Text="SSLense checks the certificate first (domains, dates, chain and key), binds it, and checks the site serves it. If it doesn't, the previous binding is put back. Only a .crt file, without its key? Use 'the provider needs a request' instead." />
                <Button Content="Install" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
