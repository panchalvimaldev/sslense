<UserControl x:Class="SSLense.Gui.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Renewal, notification, and Windows Service settings" Foreground="#5E6B76" Margin="0,4,0,18"/>
   <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding ResultMessage}" Foreground="#247A3D" FontWeight="SemiBold" TextWrapping="Wrap"/>

   <GroupBox Header="General" Padding="14" Margin="0,10,0,12"><StackPanel>
    <TextBlock Text="Default ACME email"/><TextBox Text="{Binding DefaultEmail}" Padding="6" Margin="0,4,0,10"/>
    <TextBlock Text="Renewal threshold (days)"/><TextBox Text="{Binding RenewalThresholdDays}" Padding="6" Margin="0,4,0,10" Width="100" HorizontalAlignment="Left"/>
    <StackPanel Orientation="Horizontal"><RadioButton Content="Staging (default and enforced)" IsChecked="True" Margin="0,0,20,0"/><RadioButton Content="Production (disabled)" IsEnabled="False"/></StackPanel>
    <Button Content="Save General Settings" Command="{Binding SaveGeneralCommand}" Padding="14,7" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </StackPanel></GroupBox>

   <GroupBox Header="Notifications" Padding="14" Margin="0,0,0,12"><StackPanel>
    <TextBlock Text="{Binding NotificationStatus}" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0">
      <TextBlock Text="SMTP host"/><TextBox Text="{Binding SmtpHost}" Padding="5"/><TextBlock Text="Port" Margin="0,7,0,0"/><TextBox Text="{Binding SmtpPort}" Padding="5"/>
      <CheckBox Content="Use TLS" IsChecked="{Binding SmtpTls}" Margin="0,7"/><TextBlock Text="Username"/><TextBox Text="{Binding SmtpUsername}" Padding="5"/>
      <TextBlock Text="Password (enter to replace)" Margin="0,7,0,0"/><PasswordBox PasswordChanged="OnSmtpPasswordChanged" Padding="5"/>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <TextBlock Text="From"/><TextBox Text="{Binding SmtpFrom}" Padding="5"/><TextBlock Text="To" Margin="0,7,0,0"/><TextBox Text="{Binding SmtpTo}" Padding="5"/>
      <TextBlock Text="Webhook URL (enter to replace)" Margin="0,7,0,0"/><PasswordBox PasswordChanged="OnWebhookChanged" Padding="5"/>
      <CheckBox Content="Notify on successful renewal" IsChecked="{Binding NotifyOnSuccess}" Margin="0,10,0,0"/>
     </StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
     <Button Content="Save Notifications" Command="{Binding SaveNotificationsCommand}" Padding="14,7" Margin="0,0,8,0"/><Button Content="Send Test" Command="{Binding TestNotificationCommand}" Padding="14,7" Margin="0,0,8,0"/><Button Content="Clear" Command="{Binding ClearNotificationsCommand}" Padding="14,7"/>
    </StackPanel>
   </StackPanel></GroupBox>

   <GroupBox Header="Windows Service" Padding="14"><StackPanel>
    <TextBlock Text="{Binding ServiceStatus, StringFormat=Status: {0}}" FontWeight="SemiBold"/>
    <TextBlock Text="Service executable" Margin="0,8,0,0"/><TextBox Text="{Binding ServicePath}" Padding="6"/>
    <WrapPanel Margin="0,12,0,0"><Button Content="Install" Command="{Binding InstallServiceCommand}" Padding="14,7" Margin="0,0,8,0"/><Button Content="Start" Command="{Binding StartServiceCommand}" Padding="14,7" Margin="0,0,8,0"/><Button Content="Stop" Command="{Binding StopServiceCommand}" Padding="14,7" Margin="0,0,8,0"/><Button Content="Uninstall" Command="{Binding UninstallServiceCommand}" Padding="14,7" Margin="0,0,8,0"/><Button Content="Refresh" Command="{Binding RefreshServiceCommand}" Padding="14,7"/></WrapPanel>
   </StackPanel></GroupBox>
  </StackPanel>
 </ScrollViewer>
</UserControl>
