<UserControl x:Class="SSLense.Gui.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/><TextBlock Text="Configure renewal behavior, notifications, and the background service." Style="{StaticResource PageSubtitle}" Margin="0,4,0,18"/>
   <Border Margin="0,0,0,10"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
   <TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>

   <GroupBox Header="General" Margin="0,10,0,14"><StackPanel>
    <TextBlock Text="DEFAULT ACME EMAIL" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DefaultEmail}" Margin="0,0,0,14"/>
    <TextBlock Text="RENEWAL THRESHOLD (DAYS)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RenewalThresholdDays}" Margin="0,0,0,14" Width="120" HorizontalAlignment="Left"/>
    <TextBlock Text="Staging is the safe default. Production must be selected and explicitly acknowledged for each new issuance." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
    <Button Content="Save general settings" Command="{Binding SaveGeneralCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
   </StackPanel></GroupBox>

   <GroupBox Header="Notifications" Margin="0,0,0,14"><StackPanel>
    <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,16"><TextBlock Text="{Binding NotificationStatus}" FontWeight="SemiBold"/></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0">
      <TextBlock Text="SMTP HOST" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SmtpHost}"/><TextBlock Text="PORT" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><TextBox Text="{Binding SmtpPort}"/>
      <CheckBox Content="Use TLS" IsChecked="{Binding SmtpTls}" Margin="0,12"/><TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SmtpUsername}"/>
      <TextBlock Text="PASSWORD (ENTER TO REPLACE)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><PasswordBox PasswordChanged="OnSmtpPasswordChanged"/>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <TextBlock Text="FROM ADDRESS" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SmtpFrom}"/><TextBlock Text="TO ADDRESS" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><TextBox Text="{Binding SmtpTo}"/>
      <TextBlock Text="WEBHOOK URL (ENTER TO REPLACE)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><PasswordBox PasswordChanged="OnWebhookChanged"/>
      <CheckBox Content="Notify on successful renewal" IsChecked="{Binding NotifyOnSuccess}" Margin="0,10,0,0"/>
     </StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
     <Button Content="Save notifications" Command="{Binding SaveNotificationsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="Send test" Command="{Binding TestNotificationCommand}" Margin="0,0,8,0"/><Button Content="Clear settings" Command="{Binding ClearNotificationsCommand}" Style="{StaticResource DangerButton}"/>
    </StackPanel>
   </StackPanel></GroupBox>

   <GroupBox Header="Windows Service"><StackPanel>
    <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,14"><TextBlock Text="{Binding ServiceStatus, StringFormat=Service status: {0}}" FontWeight="SemiBold"/></Border>
    <TextBlock Text="SERVICE EXECUTABLE" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ServicePath}"/>
    <WrapPanel Margin="0,16,0,0"><Button Content="Install" Command="{Binding InstallServiceCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="Start" Command="{Binding StartServiceCommand}" Margin="0,0,8,0"/><Button Content="Stop" Command="{Binding StopServiceCommand}" Margin="0,0,8,0"/><Button Content="Uninstall" Command="{Binding UninstallServiceCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0"/><Button Content="Refresh status" Command="{Binding RefreshServiceCommand}"/></WrapPanel>
   </StackPanel></GroupBox>
  </StackPanel>
 </ScrollViewer>
</UserControl>
