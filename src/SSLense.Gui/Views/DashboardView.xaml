<UserControl x:Class="SSLense.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" Foreground="#17212B" />
                <TextBlock Text="Managed IIS certificates and staging renewal status" Foreground="#5E6B76" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Issue New" Command="{Binding IssueNewCommand}" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="View Details" Command="{Binding ViewDetailsCommand}" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Renew Selected" Command="{Binding RenewSelectedCommand}" Padding="14,7" Margin="0,0,8,0"
                        ToolTip="Immediately replace the selected staging certificate" />
                <Button Content="Renew All Due" Command="{Binding RenewAllCommand}" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="14,7" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#FFF4CE" BorderBrush="#E0B84A" BorderThickness="1" CornerRadius="4"
                Padding="10" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Padding="12,4" />
                <StackPanel>
                    <TextBlock Text="{Binding Activity}" Foreground="#5D4A00" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8DEE4" BorderThickness="1" CornerRadius="5">
            <DataGrid ItemsSource="{Binding Certificates}"
                      SelectedItem="{Binding SelectedCertificate}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0"
                      RowHeaderWidth="0" SelectionMode="Single">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="ToolTip" Value="{Binding Thumbprint}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKey}" Value="Green">
                                <Setter Property="Background" Value="#EAF7EE" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKey}" Value="Amber">
                                <Setter Property="Background" Value="#FFF4CE" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKey}" Value="Red">
                                <Setter Property="Background" Value="#FDECEC" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CFE5FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Site" Binding="{Binding SiteName}" Width="1.2*" />
                    <DataGridTextColumn Header="Host names" Binding="{Binding Hosts}" Width="2.2*" />
                    <DataGridTextColumn Header="Expiry (UTC)" Binding="{Binding Expiry, StringFormat={}{0:yyyy-MM-dd}}" Width="130" />
                    <DataGridTextColumn Header="Days left" Binding="{Binding DaysRemaining}" Width="90" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <GroupBox Grid.Row="3" Header="Operation progress" Margin="0,14,0,0" Padding="6">
            <ListBox ItemsSource="{Binding ProgressLines}" FontFamily="Consolas" FontSize="12"
                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</UserControl>
