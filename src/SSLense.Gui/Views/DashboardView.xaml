<UserControl x:Class="SSLense.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SSLense.Gui.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The list: every managed certificate, grouped by IIS site. -->
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,14,12,6">
                    <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="10,7,30,7"
                             AutomationProperties.Name="Filter certificates" />
                    <TextBlock Text="Filter by domain or site" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Command="{Binding RefreshCommand}" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right" MinHeight="0" Padding="8,4" Margin="0,0,2,0"
                            ToolTip="Refresh the list" AutomationProperties.Name="Refresh the list" />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="No certificates yet." Style="{StaticResource CaptionText}" Margin="20,12"
                           Visibility="{Binding HasNoCertificates, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ListBox ItemsSource="{Binding CertificatesView}" SelectedItem="{Binding SelectedCertificate}"
                         BorderThickness="0" Background="Transparent" Padding="8,0,8,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Certificates">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="8,14,8,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="10,9" Margin="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F5F9" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource BrandSoftBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,10,0" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="8,1,0,0">
                                    <TextBlock Text="{Binding SourceTag}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hosts}" />
                                    <TextBlock Text="{Binding DaysText}" Style="{StaticResource StatusText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource InfoBanner}" Margin="28,20,28,0"
                    Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissNoticeCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                </DockPanel>
            </Border>

            <!-- Nothing selected: a summary, and the certificates that need the administrator. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowOverview, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="28,24,28,28" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Your certificates" Style="{StaticResource DetailTitle}" />
                    <TextBlock Text="Choose a certificate on the left to see it, or add a new one." Style="{StaticResource PageSubtitle}" />

                    <UniformGrid Columns="4" Margin="0,20,0,0">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="Certificates" Style="{StaticResource CaptionText}" FontWeight="SemiBold" /><TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="Need attention" Style="{StaticResource CaptionText}" FontWeight="SemiBold" /><TextBlock Text="{Binding AttentionCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="Renew automatically" Style="{StaticResource CaptionText}" FontWeight="SemiBold" /><TextBlock Text="{Binding AutomaticCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel><TextBlock Text="You renew" Style="{StaticResource CaptionText}" FontWeight="SemiBold" /><TextBlock Text="{Binding ByHandCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /></StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding HasAttention, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Needs your attention" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding NeedsAttention}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,12,0" />
                                                <Button DockPanel.Dock="Right" Content="Show" VerticalAlignment="Center" Margin="12,0,0,0"
                                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding StatusHead}" Style="{StaticResource StatusText}" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SuccessBanner}" Margin="0,16,0,0" Padding="18,14"
                            Visibility="{Binding AllFine, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Everything is fine" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="No certificate needs you right now." Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding HasNoCertificates, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="No certificates yet" Style="{StaticResource SectionTitle}" FontSize="15" />
                            <TextBlock Text="Get a free certificate that renews itself, install one you bought, or watch the certificates already in IIS." Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <Button Content="＋  Add certificate" Command="{Binding AddCertificateCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- A certificate is selected. -->
            <views:CertificateDetailsView Grid.Row="1" DataContext="{Binding Details}"
                                          Visibility="{Binding HasCertificate, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Install renewal, over the whole page while it is open. -->
        <views:InstallRenewalView Grid.ColumnSpan="2" DataContext="{Binding Details.InstallRenewal}"
                                  Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
