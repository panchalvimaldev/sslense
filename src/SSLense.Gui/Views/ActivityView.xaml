<UserControl x:Class="SSLense.Gui.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SSLense.Gui.Views">
    <!-- Activity: what is running, the health checks, and the log, on one page (docs/design/gui-redesign.md). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Activity" Style="{StaticResource DetailTitle}" />
            <TextBlock Text="What is running, whether SSLense can renew your certificates, and what it did." Style="{StaticResource PageSubtitle}" Margin="0,5,0,16" />

            <!-- Running now: renewals started in the app, step by step. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel DataContext="{Binding Certificates}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Clear" Command="{Binding ClearProgressCommand}" Style="{StaticResource LinkButton}"
                                    Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Text="Running now" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Activity}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,8,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="Nothing is running. The SSLense service checks every hour and renews what is due; renewals you start here show their steps here."
                               Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Visibility><Binding Path="IsIdle" Converter="{StaticResource BooleanToVisibilityConverter}" /></TextBlock.Visibility>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ProgressLines}" Margin="0,8,0,0" Focusable="False"
                                  Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Renewal progress">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <views:HealthView DataContext="{Binding Health}" Margin="0,0,0,16" />
            <views:LogsView DataContext="{Binding Logs}" Height="520" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
