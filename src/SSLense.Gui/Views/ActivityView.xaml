<UserControl x:Class="SSLense.Gui.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SSLense.Gui.Views">
    <Grid Margin="28,14,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Renewals started from the window, step by step; hidden until there are some. -->
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,4" ClipToBounds="True" MaxHeight="190"
                Visibility="{Binding Certificates.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,10">
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding Certificates.ClearProgressCommand}" Style="{StaticResource LinkButton}" />
                    <TextBlock Text="Renewals started here" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Certificates.ProgressLines}" Style="{StaticResource ConsoleList}" AutomationProperties.Name="Renewal progress" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Style="{StaticResource SectionTabs}" SelectedIndex="{Binding SelectedTab}" AutomationProperties.Name="Activity sections">
            <TabItem Header="Health checks">
                <views:HealthView DataContext="{Binding Health}" />
            </TabItem>
            <TabItem Header="Log">
                <views:LogsView DataContext="{Binding Logs}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
