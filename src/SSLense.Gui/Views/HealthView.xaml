<UserControl x:Class="SSLense.Gui.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Activity › Health checks: one card, each check a line with what to do about it. -->
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Run checks" Command="{Binding RunCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="Health checks" Style="{StaticResource SectionTitle}" FontSize="15" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionWhenSet}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionWhenSet}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource WhenSet}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- The results fold away, so the diagnostic bundle below stays in reach. -->
            <Expander IsExpanded="True" Margin="0,10,0,0" Foreground="{StaticResource BrandBrush}" AutomationProperties.Name="Health check results">
                <Expander.Header><TextBlock><Run Text="Results of " /><Run Text="{Binding Results.Count, Mode=OneWay}" /><Run Text=" checks" /></TextBlock></Expander.Header>
                <Expander.Style><Style TargetType="Expander"><Style.Triggers><DataTrigger Binding="{Binding Results.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Expander.Style>
            <ItemsControl ItemsSource="{Binding Results}" Margin="0,6,0,0" Focusable="False" TextElement.Foreground="{StaticResource TextBrush}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" Margin="0,2,8,0" VerticalAlignment="Top"
                                           AutomationProperties.Name="{Binding Result}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE73E;" /><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Result}" Value="WARN"><Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="FAIL"><Setter Property="Text" Value="&#xE711;" /><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,3,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="FontSize" Value="13" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Fix}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                        <Run Text="To fix:" FontWeight="SemiBold" /> <Run Text="{Binding Fix, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Expander>

            <Expander Header="Diagnostic bundle for support" Margin="0,8,0,0" Foreground="{StaticResource BrandBrush}">
                <StackPanel Margin="0,10,0,0" TextElement.Foreground="{StaticResource TextBrush}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"
                               Text="Saves a zip to your Desktop with health results, settings, bindings, and recent logs to attach to a GitHub issue. Passwords, keys, protected values, and webhook URLs are removed automatically." />
                    <CheckBox Content="Replace site names, host names, and site folders with placeholders (for public posts)" IsChecked="{Binding RedactHosts}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Create bundle" Command="{Binding CreateBundleCommand}" Margin="0,0,8,0" />
                        <Button Content="Show in folder" Command="{Binding ShowBundleCommand}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
